# Runtime connection (app_user: RLS enforced)
APP_DATABASE_URL=postgres://app_user:app_user@localhost:54329/sge
# Owner connection (migrations only)
DATABASE_URL_OWNER=postgres://app_owner:app_owner@localhost:54329/sge
# Identity connection (auth_user: schema "auth" only)
AUTH_DATABASE_URL=postgres://auth_user:auth_user@localhost:54329/sge
# Job queue connection (worker_user: jobs/schedules only)
WORKER_DATABASE_URL=postgres://worker_user:worker_user@localhost:54329/sge
# ≥ 32 chars:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Outgoing mail. Local dev: Mailpit (UI at http://localhost:8025)
# MAIL_TRANSPORT=log is a demo-only mode: nothing is sent, links go to the server log.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Futuready Media <no-reply@futureadymedia.local>"
# Optional Google sign-in (free OAuth client). Leave blank to hide the button.
# Optional: platform-wide Google PageSpeed Insights key (free). Workspaces can add their own in Settings → Integrations.
PSI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
PRODUCT_NAME="Futuready Media"
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Shared secret for cron/tick endpoints (min 16 chars)
CRON_SECRET=

# Database pool size per server instance. Vercel/serverless: 3. Long-running server: 10.
DB_POOL_MAX=10
