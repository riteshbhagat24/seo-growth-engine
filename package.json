{
  "name": "seo-growth-engine",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "pnpm --filter @sge/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @sge/db generate",
    "db:migrate": "pnpm --filter @sge/db migrate",
    "build:standalone": "pnpm --filter @sge/web build && node scripts/prepare-standalone.mjs",
    "e2e": "playwright test"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@^4.50.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
